	<detail>
		<band height="28">
			<element kind="line" uuid="32f5ec6e-b6f3-4628-bfd0-fc0d0dce1188" x="0" y="27" width="802" height="1" forecolor="#DADDE3"/>
			<element kind="textField" uuid="06cfd2c4-0481-4aca-9c5f-8b0d027507e0" x="0" y="1" width="60" height="25" forecolor="#06245C" fontSize="9.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
				<expression><![CDATA[$F{folioEmpleado}]]></expression>
			</element>
			<element kind="textField" uuid="ae4935b8-dc97-466e-9a7c-7d77b015717a" x="60" y="1" width="190" height="25" fontSize="9.0" vTextAlign="Middle">
				<expression><![CDATA[$F{nombreEmpleado}]]></expression>
			</element>
			<element kind="textField" uuid="4e4734cb-40c5-4ffb-b8d6-c67a0d21ac0c" x="250" y="1" width="90" height="25" fontSize="9.0" hTextAlign="Center" vTextAlign="Middle">
				<expression><![CDATA[
                    $F{fecha} == null
                    ? ""
                    : $F{fecha}.format(
                        java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy")
                      )
                ]]></expression>
			</element>
			<element kind="textField" uuid="8c36199b-0ad5-4144-bdc9-5761a9f8154e" x="340" y="1" width="85" height="25" fontSize="9.0" hTextAlign="Center" vTextAlign="Middle">
				<expression><![CDATA[
                    $F{marcaEntrada} == null
                        || $F{marcaEntrada}.getFechaHora() == null
                        ? "-"
                    : $F{marcaEntrada}.getFechaHora().format(
                        java.time.format.DateTimeFormatter.ofPattern("HH:mm")
                        )
                ]]></expression>
			</element>
			<element kind="textField" uuid="25900319-fa35-42f5-987a-69cf1b657867" x="425" y="1" width="85" height="25" fontSize="9.0" hTextAlign="Center" vTextAlign="Middle">
				<expression><![CDATA[
                    $F{marcaEntrada} == null
                        || $F{marcaEntrada}.getFechaHora() == null
                        ? "-"
                    : $F{marcaSalida}.getFechaHora().format(
                        java.time.format.DateTimeFormatter.ofPattern("HH:mm")
                        )
                ]]></expression>
			</element>
			<element kind="textField" uuid="a4daad1d-b2ae-46db-932b-babcb15228f3" x="510" y="1" width="95" height="25" fontSize="9.0" pattern="0.00 'h'" hTextAlign="Center" vTextAlign="Middle">
				<expression><![CDATA[
                    $F{horasTrabajadas}
                ]]></expression>
			</element>
			<element kind="textField" uuid="a4ffdc40-53ae-4555-b09d-1707be90681a" x="605" y="1" width="80" height="25" fontSize="9.0" hTextAlign="Center" vTextAlign="Middle">
				<expression><![CDATA[
                    Boolean.TRUE.equals($F{esDiaLibre}) ? "Sí" : "No"
                ]]></expression>
			</element>
			<element kind="textField" uuid="9dbe333d-be9f-4dba-bbdd-e98be2ac9c36" x="685" y="1" width="117" height="25" fontSize="9.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
				<expression><![CDATA[
                    Boolean.TRUE.equals($F{completa})
                    ? "Completa"
                    : "Incompleta"
                ]]></expression>
