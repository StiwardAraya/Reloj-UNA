<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" fx:id="root" stylesheets="@css/UtilStyles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.relojuna.controller.MainHeaderController">
   <children>
      <HBox stylesheets="@css/MFXOverrides.css" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <ImageView fitHeight="48.0" fitWidth="48.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/clock-icon-white-64.png" />
               </image>
            </ImageView>
            <VBox styleClass="align-left">
               <children>
                  <Label fx:id="lblTitulo" text="Universidad Nacional">
                     <styleClass>
                        <String fx:value="font-bold" />
                        <String fx:value="text-2xl" />
                        <String fx:value="text-gray-200" />
                     </styleClass></Label>
                  <Label fx:id="lblSubTitulo" text="Control de entradas y salidas">
                     <styleClass>
                        <String fx:value="text-lg" />
                        <String fx:value="text-gray-300" />
                     </styleClass>
                  </Label>
               </children>
            </VBox>
         </children>
         <styleClass>
            <String fx:value="p-3" />
            <String fx:value="align-left" />
            <String fx:value="gap-3" />
            <String fx:value="bg-blue-900" />
         </styleClass>
      </HBox>
   </children>
</AnchorPane>
