<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import io.github.palexdev.materialfx.controls.MFXDatePicker?>
<?import io.github.palexdev.materialfx.controls.MFXTextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="root"
            prefHeight="720.0"
            prefWidth="1000.0"
            styleClass="bg-gray-50"
            xmlns="http://javafx.com/javafx/25.0.2"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.una.relojuna.controller.ReporteViewController">

    <children>
        <VBox spacing="18.0"
              AnchorPane.topAnchor="0.0"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">

            <padding>
                <Insets top="20.0"
                        right="24.0"
                        bottom="20.0"
                        left="24.0"/>
            </padding>

            <!-- Encabezado -->
            <VBox spacing="4.0">
                <Label text="Reportes JasperReports"
                       styleClass="h2, font-bold, text-gray-900"/>

                <Label text="Genere los reportes de empleados y marcas del sistema."
                       styleClass="text-base, text-gray-500"/>
            </VBox>

            <!-- Reporte 1: empleados -->
            <VBox spacing="14.0"
                  styleClass="bg-white, border, border-gray-200, rad-md, p-4">

                <Label text="Reporte de empleados"
                       styleClass="text-lg, font-semibold, text-gray-800"/>

                <Label text="Muestra la información general de todos los empleados registrados."
                       wrapText="true"
                       styleClass="text-sm, text-gray-500"/>

                <HBox alignment="CENTER_RIGHT">
                    <MFXButton fx:id="btnReporteEmpleados"
                               text="Generar reporte de empleados"
                               prefWidth="230.0"
                               styleClass="primary"
                               onAction="#generarReporteEmpleados"/>
                </HBox>
            </VBox>

            <!-- Reporte 2: marcas -->
            <VBox spacing="14.0"
                  styleClass="bg-white, border, border-gray-200, rad-md, p-4">

                <Label text="Reporte de marcas"
                       styleClass="text-lg, font-semibold, text-gray-800"/>

                <Label text="Muestra las marcas y horas trabajadas de un empleado o de todos los empleados en un rango de fechas."
                       wrapText="true"
                       styleClass="text-sm, text-gray-500"/>

                <GridPane hgap="14.0" vgap="10.0">

                    <Label text="Fecha inicial"
                           styleClass="font-semibold, text-gray-700"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="0"/>

                    <Label text="Fecha final"
                           styleClass="font-semibold, text-gray-700"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"/>

                    <Label text="Folio del empleado"
                           styleClass="font-semibold, text-gray-700"
                           GridPane.columnIndex="2"
                           GridPane.rowIndex="0"/>

                    <MFXDatePicker fx:id="dpFechaInicio"
                                   prefWidth="220.0"
                                   promptText="Fecha inicial"
                                   styleClass="outlined"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="1"/>

                    <MFXDatePicker fx:id="dpFechaFin"
                                   prefWidth="220.0"
                                   promptText="Fecha final"
                                   styleClass="outlined"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="1"/>

                    <MFXTextField fx:id="txtFolio"
                                  prefWidth="220.0"
                                  promptText="Vacío para todos"
                                  floatingText="Folio"
                                  styleClass="outlined"
                                  GridPane.columnIndex="2"
                                  GridPane.rowIndex="1"/>
                </GridPane>

                <HBox alignment="CENTER_RIGHT">
                    <MFXButton fx:id="btnReporteMarcas"
                               text="Generar reporte de marcas"
                               prefWidth="230.0"
                               styleClass="primary"
                               onAction="#generarReporteMarcas"/>
                </HBox>
            </VBox>

            <Label text="Los reportes se mostrarán en el visor de JasperReports y podrán exportarse a PDF."
                   wrapText="true"
                   styleClass="text-sm, text-gray-500"/>

        </VBox>
    </children>
</AnchorPane>